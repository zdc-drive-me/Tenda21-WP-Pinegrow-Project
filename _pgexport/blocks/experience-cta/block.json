{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "tenda21/experience-cta",
    "title": "Experience CTA",
    "description": "Booking call-to-action for a single Experience page. Supports custom booking note, CTA label, and CTA URL.",
    "category": "tenda21_experience",
    "keywords": [],
    "supports": {},
    "attributes": {
        "experience_booking_note": {
            "type": "string",
            "default": "Booking note or availability message."
        },
        "experience_cta_url": {
            "type": "object",
            "default": {
                "post_id": 0,
                "url": "mailto:hello@tenda21.com",
                "title": "",
                "post_type": null
            }
        },
        "experience_cta_label": {
            "type": "string",
            "default": "Reserve Your Place"
        }
    },
    "version": "1.0.122",
    "editorScript": "block-tenda21-experience-cta-script",
    "example": {
        "attributes": {}
    },
    "icon": "block-default"
}
