{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "tenda21/site-header",
    "title": "Site Header",
    "description": "Site header with logo, primary navigation and language switcher",
    "category": "tenda21_blocks",
    "keywords": [],
    "supports": {},
    "attributes": {
        "logo": {
            "type": "object",
            "default": {
                "id": 0,
                "url": "assets/images/home/site%20logo.webp",
                "size": "",
                "svg": "",
                "alt": "Tenda 21"
            }
        },
        "divider_image": {
            "type": "object",
            "default": {
                "id": 0,
                "url": "assets/images/home/menu_line_devider.webp",
                "size": "",
                "svg": "",
