        "language_link_pt_mobile": {
            "type": "object",
            "default": {
                "post_id": 0,
                "url": "#",
                "title": "",
                "post_type": null
            }
        },
        "language_label_pt_mobile": {
            "type": "string",
            "default": "PT"
        }
    },
    "version": "1.0.134",
    "editorScript": "block-tenda21-site-header-script",
    "example": {
        "attributes": {}
