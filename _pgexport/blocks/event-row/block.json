{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "tenda21/event-row",
    "title": "Event Row",
    "description": "Single event row with thumbnail, facilitators, schedule, and booking metadata.",
    "category": "tenda21_event",
    "keywords": [],
    "supports": {},
    "attributes": {
        "event_featured": {
            "type": "object",
            "default": {
                "id": 0,
                "url": "https://images.unsplash.com/photo-1502082553048-f009c37129b9?auto=format&fit=crop&w=400&q=80",
                "size": "",
                "svg": "",
                "alt": null
            }
        },
        "event_experience": {
            "type": "object",
            "default": {
                "post_id": 0,
                "url": "#",
                "title": "",
                "post_type": null
            }
        },
        "event_location_type": {
            "type": "string",
            "default": "On-site"
        },
        "event_excerpt": {
            "type": "string",
            "default": "Three days of contemplative silence, mindful movement, and nature-based ritual held in a small circle."
        },
        "event_location": {
            "type": "string",
            "default": "Serra da Estrela · Portugal"
        },
        "event_start_date": {
            "type": "string",
            "default": "12 April 2024"
        },
        "event_start_time": {
            "type": "string",
            "default": "09:00"
        },
        "event_end_date": {
            "type": "string",
            "default": "14 April 2024"
        },
        "event_end_time": {
            "type": "string",
            "default": "14:00"
        },
        "event_price_label": {
            "type": "string",
            "default": "Investment"
        },
        "event_price": {
            "type": "string",
            "default": "€420"
        },
        "event_booking_status": {
            "type": "string",
            "default": "Few seats left"
        },
        "event_booking": {
            "type": "object",
            "default": {
                "post_id": 0,
                "url": "#",
                "title": "",
                "post_type": null
            }
        }
    },
    "version": "1.0.119",
    "editorScript": "block-tenda21-event-row-script",
    "example": {
        "attributes": {}
    },
    "icon": "block-default"
}
